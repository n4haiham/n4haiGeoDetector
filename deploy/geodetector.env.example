# Shell configuration, read by the launcher. Quote values containing spaces.
IMAGE=n4hai-geodetector:local
GPS_DEVICE=/dev/ttyUSB0
GPS_RATE=4800
# GPSD shares the receiver with Chrony/cgps. Empty means legacy serial mode.
GPSD_HOST=127.0.0.1
GPSD_PORT=2947
# The LCD's framebuffer; mapped to /dev/fb0 inside the container.
FB_DEVICE=/dev/fb0
# Rotate the LCD image 180 degrees when mounted upside down.
FLIP_SCREEN=false
# Optional TV demo mirror; HDMI must have a separate Linux framebuffer.
HDMI_MIRROR=false
HDMI_DEVICE=/dev/fb1
# County history browser port; use 0 to disable.
HISTORY_PORT=8081
# Optional absolute host path to a KML file or directory.
# Empty uses all KML files from ./boundaries, included in the image at build time.
BOUNDARY_FILE=
